	<string>Mon Jardin a besoin d'accéder à votre galerie photo pour ajouter des visuels à votre journal de culture.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
